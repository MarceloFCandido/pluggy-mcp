# Copy to .env for terminal use, or configure these in your MCP client's server environment.
PLUGGY_CLIENT_ID=your-application-client-id
PLUGGY_CLIENT_SECRET=your-application-client-secret

# Known item IDs, comma-separated. Required for sync unless registered through a tool.
# PLUGGY_ITEM_IDS=00000000-0000-4000-8000-000000000001

# Optional PostgreSQL mirror. Omit for direct API mode.
# DATABASE_URL=postgresql://pluggy:password@localhost:5432/pluggy

# All POST/PATCH/PUT/DELETE product operations are disabled by default.
PLUGGY_ALLOW_WRITES=false

# Optional schedule in seconds; 0 means on-demand only. Requires DATABASE_URL.
PLUGGY_SYNC_INTERVAL_SECONDS=0

# Optional authenticated webhook receiver. Requires DATABASE_URL.
# PLUGGY_WEBHOOK_PORT=3001
# PLUGGY_WEBHOOK_HOST=127.0.0.1
# PLUGGY_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Separately provisioned enrichment-product API key, not your main API key.
# PLUGGY_ENRICHMENT_API_KEY=your-enrichment-api-key

PLUGGY_TIMEOUT_MS=30000
PLUGGY_MAX_SYNC_PAGES=1000
